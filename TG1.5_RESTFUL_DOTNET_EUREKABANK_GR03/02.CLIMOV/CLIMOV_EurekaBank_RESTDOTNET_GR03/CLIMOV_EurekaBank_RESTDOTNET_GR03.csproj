<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CLIMOV_EurekaBank_RESTDOTNET_GR03</RootNamespace>
    <UseMaui>true</UseMaui>
    <UseWinUI>true</UseWinUI>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>CLIMOV_EurekaBank_RESTDOTNET_GR03</ApplicationTitle>
    <ApplicationId>com.companyname.CLIMOV_EurekaBank_RESTDOTNET_GR03</ApplicationId>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0'">true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <MauiImage Include="Resources\Images\*.png" />
    <EmbeddedResource Include="Resources\Images\*.png" />
  </ItemGroup>
  <ItemGroup>
    <MauiXaml Update="App.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
    <MauiXaml Update="AppShell.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
    <MauiXaml Update="Views\LoginScreen.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
    <MauiXaml Update="Views\AccountsScreen.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
    <MauiXaml Update="Views\MovementsScreen.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
    <MauiXaml Update="Resources\Styles\RESTDotNetTheme.xaml"><Generator>MSBuild:Compile</Generator></MauiXaml>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Views\AccountsScreen.xaml.cs"><DependentUpon>AccountsScreen.xaml</DependentUpon></Compile>
  </ItemGroup>
</Project>
