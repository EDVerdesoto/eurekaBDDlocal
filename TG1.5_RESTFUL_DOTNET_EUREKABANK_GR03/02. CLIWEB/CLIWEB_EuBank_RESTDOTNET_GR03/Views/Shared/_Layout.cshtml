@{
    var usuario = Context.Session.GetString("Usuario");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EuBank REST</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body class="bg-gray-50 min-h-screen">
    @if (usuario != null)
    {
        <header class="bg-white shadow-sm border-b border-gray-200">
            <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex items-center">
                        <span class="text-xl font-bold text-purple-600">EuBank REST</span>
                        <span class="ml-6 text-sm text-gray-500">Panel de Control</span>
                    </div>
                    <div class="flex items-center space-x-4">
                        <span class="text-sm text-gray-700">Usuario: <strong class="text-purple-600">@usuario</strong></span>
                        <a href="@Url.Action("Logout", "Auth")" class="text-red-600 hover:text-red-800 px-3 py-2 rounded-md text-sm font-medium">Cerrar Sesion</a>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        @RenderBody()
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
